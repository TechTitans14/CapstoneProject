        "type": "object",
        "properties": {
          "appointmentID": {
            "type": "integer",
            "format": "int32"
          },
          "patientID": {
            "type": "integer",
            "format": "int32"
          },
          "doctorID": {
            "type": "integer",
            "format": "int32"
          },
          "bookedBy": {
